{
  "name": "@stealth-seller/watchers-backend",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/server.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@trpc/server": "^10.45.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "superjson": "^2.2.6",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
