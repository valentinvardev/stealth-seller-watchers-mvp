{
  "version": 2,
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend"
    }
  },
  "env": {
    "FIRECRAWL_API_KEY": "@firecrawl_api_key",
    "OPENROUTER_API_KEY": "@openrouter_api_key",
    "VITE_API_URL": "@vite_api_url",
    "NPM_TOKEN": "@npm_token"
  },
  "rewrites": [
    {
      "source": "/trpc(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
