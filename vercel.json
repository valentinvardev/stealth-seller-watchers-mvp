{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/trpc/:path*",
      "destination": "http://localhost:3000/trpc/:path*"
    }
  ],
  "env": {
    "VITE_API_URL": "@vite_api_url"
  }
}
